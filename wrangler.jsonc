// Cloudflare Workers static assets: `npm run build` exports the site to out/,
// then `npx wrangler deploy` uploads that folder. No Worker script runs.
{
  "name": "testingapis",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  // Cloudflare creates the DNS records and certificates for these hostnames.
  "routes": [
    { "pattern": "testingapis.com", "custom_domain": true },
    { "pattern": "www.testingapis.com", "custom_domain": true }
  ]
}
