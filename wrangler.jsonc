// Cloudflare Workers static assets: `npm run build` exports the site to out/,
// then `npx wrangler deploy` uploads that folder. No Worker script runs.
{
  "name": "testingapis",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
